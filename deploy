#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENTS_MD="$REPO/agents/AGENTS.md"

# ── helpers ──────────────────────────────────────────────────────────────────

green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
red()    { printf '\033[31m%s\033[0m\n' "$*"; }

# Create a symlink src -> dst.
# Safe: skips if already correct, warns if dst exists and is something else.
make_link() {
    local src="$1" dst="$2"

    if [ -L "$dst" ]; then
        local current
        current="$(readlink "$dst")"
        if [ "$current" = "$src" ]; then
            green "  ok      $dst"
            return
        else
            yellow "  skip    $dst  (already links to $current)"
            return
        fi
    fi

    if [ -e "$dst" ]; then
        yellow "  skip    $dst  (exists, not a symlink — handle manually)"
        return
    fi

    ln -s "$src" "$dst"
    green "  linked  $dst -> $src"
}

# Create directory if missing, report either way.
ensure_dir() {
    local dir="$1"
    if [ -d "$dir" ]; then
        green "  ok      $dir"
    else
        mkdir -p "$dir"
        green "  created $dir"
    fi
}

# ── global guidance files ─────────────────────────────────────────────────────

echo
echo "Global guidance files  (all -> $AGENTS_MD)"
echo "──────────────────────────────────────────"

# Claude Code: ~/.claude/CLAUDE.md
make_link "$AGENTS_MD" "$HOME/.claude/CLAUDE.md"

# Codex CLI: ~/.codex/AGENTS.md
make_link "$AGENTS_MD" "$HOME/.codex/AGENTS.md"

# Gemini CLI: ~/.gemini/GEMINI.md
make_link "$AGENTS_MD" "$HOME/.gemini/GEMINI.md"

# ── skills ────────────────────────────────────────────────────────────────────

echo
echo "Skills directories"
echo "──────────────────"

# Claude Code reads skills from ~/.claude/skills/
# Codex + Gemini both read from ~/.agents/skills/ (shared user scope)
SKILL_DIRS=(
    "$HOME/.claude/skills"
    "$HOME/.agents/skills"
)

for dir in "${SKILL_DIRS[@]}"; do
    ensure_dir "$dir"
done

echo
echo "Skills  (repo/skills/* -> each skills directory)"
echo "─────────────────────────────────────────────────"

shopt -s nullglob
skills=("$REPO/skills"/*)
shopt -u nullglob

if [ "${#skills[@]}" -eq 0 ]; then
    yellow "  no skills found in $REPO/skills/"
else
    for skill_path in "${skills[@]}"; do
        [ -d "$skill_path" ] || continue
        skill_name="$(basename "$skill_path")"
        for dir in "${SKILL_DIRS[@]}"; do
            make_link "$skill_path" "$dir/$skill_name"
        done
    done
fi

# ── Claude Code hooks ─────────────────────────────────────────────────────────

echo
echo "Claude Code hooks  (repo/hooks/claude/* -> ~/.claude/hooks/)"
echo "─────────────────────────────────────────────────────────────"

ensure_dir "$HOME/.claude/hooks"

shopt -s nullglob
claude_hooks=("$REPO/hooks/claude"/*)
shopt -u nullglob

if [ "${#claude_hooks[@]}" -eq 0 ]; then
    yellow "  no hooks found in $REPO/hooks/claude/"
else
    for hook_path in "${claude_hooks[@]}"; do
        [ -f "$hook_path" ] || continue
        hook_name="$(basename "$hook_path")"
        make_link "$hook_path" "$HOME/.claude/hooks/$hook_name"
    done
fi

echo
green "Done."
